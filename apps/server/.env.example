# 複製這個檔案成 .env，再填入你的值（.env 已在 .gitignore，不會被提交）
PORT=3001

# 沒填的話會使用假的審查員（mock），一樣可以開發
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 選填：Voyage AI 的 API key。有填的話，檢索改用向量檢索（沒填只用 BM25）
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
# 選填：vector（預設）或 hybrid（BM25 + 向量的混合檢索），可以在「AI 調校」的檢索評估比較兩者
RETRIEVAL_METHOD=vector

# 選填：評估集用哪個審查員。不填的話，公開 demo（DEMO=true）用模擬審查員，其他情況跟預審一樣
# EVAL_REVIEWER=claude
