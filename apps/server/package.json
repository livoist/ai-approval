{
  "name": "@ai-approval/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:reset": "rm -f data/app.db data/app.db-wal data/app.db-shm",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@ai-approval/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
